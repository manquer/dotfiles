#!/bin/bash

set -eufo pipefail

echo "Installing Homebrew packages and applications..."

# Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
    echo "Homebrew not found. Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Resolve brew via absolute path so a freshly-installed brew works without a shell reload.
# Also runs `brew shellenv` so node/npm/etc. installed below are available later in this script.
if [[ -x /opt/homebrew/bin/brew ]]; then
    BREW="/opt/homebrew/bin/brew"
elif [[ -x /usr/local/bin/brew ]]; then
    BREW="/usr/local/bin/brew"
else
    echo "Homebrew installation failed: brew not found in expected locations" >&2
    exit 1
fi
eval "$("$BREW" shellenv)"

# Trust external (non-official) taps so brew bundle can load their formulae.
for tap in withgraphite/tap daytonaio/cli azure/azd azure/kubelogin hashicorp/tap temporalio/brew thezoraiz/ascii-image-converter; do
    "$BREW" trust --tap "$tap"
done

# Run brew bundle with inline Brewfile
"$BREW" bundle --file=/dev/stdin <<EOF

# Taps
tap "withgraphite/tap"
tap "daytonaio/cli"
tap "azure/azd"
tap "azure/kubelogin"
tap "hashicorp/tap"
tap "temporalio/brew"
tap "thezoraiz/ascii-image-converter"

# CLI Tools - Version Control
brew "git"
brew "gh"              # GitHub CLI
brew "git-lfs"         # Git Large File Storage
brew "git-delta"       # Better git diff
brew "difftastic"      # Structural diff tool
brew "git-extras"      # Advanced git commands
brew "git-filter-repo" # Fast git history rewriting
brew "git-crypt"       # Transparent file encryption in git
brew "withgraphite/tap/graphite" # Modern Git workflow CLI
brew "bfg"             # Remove large files / secrets from git history
brew "git-cal"         # GitHub-style commit calendar in the terminal

# CLI Tools - Shell & Terminal
brew "zsh"
brew "bash"
brew "fish"            # Friendly interactive shell
brew "tmux"
brew "zellij"          # Modern terminal multiplexer
brew "herdr"           # Agent multiplexer that lives in your terminal
brew "starship"        # Modern shell prompt
brew "atuin"           # Shell history with sync
brew "nushell"         # Modern data-oriented shell
brew "zsh-autocomplete" # Real-time autocompletion for zsh

# CLI Tools - Development
brew "asdf"            # Version manager for multiple languages
brew "neovim"
brew "vim"
brew "helix"           # Modern modal editor
brew "node"
brew "deno"            # Modern JavaScript/TypeScript runtime
brew "python@3.12"
brew "go"
brew "rust"
brew "ruby"            # Ruby programming language
brew "php"             # PHP programming language
brew "composer"        # PHP dependency manager
brew "elixir"          # Elixir functional programming language
brew "lua"             # Lua scripting language
brew "openjdk"         # Java Development Kit
brew "autoconf"        # Generates configure scripts (autoreconf)
brew "automake"        # Provides aclocal; needed to build native npm deps (e.g. gifsicle) from source
brew "make"            # GNU Make (gmake) - macOS ships an ancient 3.81 due to GPLv3 avoidance
brew "pkg-config"      # Locates library compile/link flags for building from source
brew "cmake"           # Cross-platform build system generator
brew "libtool"         # GNU libtool for building shared libraries
brew "llvm"            # Upstream LLVM/Clang toolchain, newer than Xcode's bundled clang
brew "gcc"             # Real GNU GCC (Xcode's "gcc" is actually clang in disguise)
brew "jq"              # JSON processor
brew "yq"              # YAML processor
brew "tree"            # Directory tree viewer
brew "ripgrep"         # Fast grep alternative
brew "fd"              # Fast find alternative
brew "bat"             # Better cat with syntax highlighting
brew "eza"             # Modern ls replacement
brew "fzf"             # Fuzzy finder
brew "tldr"            # Simplified man pages
brew "direnv"          # Directory-specific environment variables
brew "zoxide"          # Smarter cd command
brew "watchman"        # File watching service
brew "universal-ctags" # Universal ctags for code navigation
brew "the_silver_searcher" # Fast code search tool
brew "graphviz"        # Graph visualization software
brew "pandoc"          # Universal document converter
brew "marp-cli"        # Markdown-based presentation tool
brew "check-jsonschema" # JSON Schema validator CLI
brew "yaml-language-server" # YAML LSP server
brew "ipython"         # Enhanced Python REPL

# CLI Tools - DevOps & Cloud
brew "docker"
brew "docker-compose"  # Multi-container Docker orchestration
brew "colima"          # Container runtime for macOS
brew "podman"          # Alternative container runtime
brew "podman-compose"  # Docker compose for Podman
brew "podman-tui"      # Terminal UI for Podman
brew "kubectl"
brew "helm"            # Kubernetes package manager
brew "argocd"          # GitOps continuous delivery for Kubernetes
brew "hashicorp/tap/terraform" # Disabled in homebrew-core (BUSL license)
brew "ansible"
brew "awscli"
brew "aws-sam-cli"     # AWS Serverless Application Model CLI
brew "azure-cli"
brew "azcopy"          # Azure Storage data transfer utility
brew "azure/azd/azd"   # Azure Developer CLI
brew "azure/kubelogin/kubelogin" # Kubernetes credential plugin for Azure AD (disambiguates from homebrew-core kubelogin)
brew "doctl"           # DigitalOcean CLI
brew "temporal"        # Workflow orchestration
brew "temporalio/brew/tcld" # Temporal Cloud CLI
brew "crane"           # Container registry interaction tool
brew "skopeo"          # Work with container images and registries
brew "buildkit"        # Modern Docker build engine
brew "rover"           # GraphQL CLI for Apollo Federation
brew "coder"           # Self-hosted remote development platform CLI
brew "daytonaio/cli/daytona" # Development environment manager
brew "hasura-cli"      # Hasura GraphQL Engine CLI
brew "otel-cli"        # OpenTelemetry CLI for shell scripts
brew "gemini-cli"      # Google Gemini CLI
brew "opencode"        # OpenCode AI coding assistant CLI

# CLI Tools - Utilities
brew "wget"
brew "curl"
brew "htop"
brew "btop"            # Resource monitor (better than htop)
brew "ncdu"            # Disk usage analyzer
brew "watch"
brew "gnupg"
brew "pinentry-mac"  # GUI passphrase prompt for gpg-agent
brew "openssh"
brew "chezmoi"         # Dotfile manager
brew "httpie"          # Modern HTTP client
brew "posting"         # Modern HTTP client TUI
brew "glow"            # Markdown renderer
brew "slides"          # Terminal-based presentation tool
brew "presenterm"      # Terminal-based presentation tool
brew "mosh"            # Mobile shell
brew "parallel"        # Execute jobs in parallel
brew "shellcheck"      # Shell script linter
brew "bats-core"       # Bash Automated Testing System
brew "vale"            # Prose linter
brew "cloc"            # Count lines of code
brew "speedtest-cli"   # Internet speed test
brew "gping"           # Ping with a graph
brew "iftop"           # Network bandwidth monitoring
brew "asciinema"       # Terminal session recorder
brew "redis"           # In-memory database
brew "uv"              # Fast Python package manager
brew "sentry-cli"      # Sentry command-line client
brew "task"            # Task management
brew "timewarrior"     # Time tracking
brew "terminal-notifier" # Send macOS notifications from CLI
brew "blueutil"        # Bluetooth CLI utility for macOS
brew "jwt-cli"         # JSON Web Token CLI tool
brew "thezoraiz/ascii-image-converter/ascii-image-converter" # Convert images to ASCII art
brew "yt-dlp"          # Feature-rich YouTube downloader
brew "yamllint"        # YAML linter
brew "lynx"            # Text-based web browser
brew "telnet"          # Telnet client for debugging
brew "zx"              # Shell scripting with JavaScript
brew "caddy"           # Modern web server with automatic HTTPS
brew "chafa"           # Image-to-terminal graphics converter
brew "glances"         # Cross-platform system monitor
brew "asitop"          # Apple Silicon performance monitor
brew "mactop"          # Apple Silicon top-like monitor
brew "coreutils"      # GNU core utilities (ls, cat, etc. - better defaults than BSD versions on macOS)
brew "findutils"       # GNU find, xargs, locate (gfind, gxargs, glocate)
brew "gnu-tar"         # GNU tar (better defaults than BSD tar on macOS)
brew "gawk"            # GNU awk (BSD/macOS ships the older "one true awk")
brew "diffutils"       # GNU diff, cmp, diff3 (macOS ships an old BSD diff)
brew "gnu-sed"         # GNU sed (better defaults than BSD sed on macOS)
brew "grep"            # GNU grep
brew "mpv"             # Media player
