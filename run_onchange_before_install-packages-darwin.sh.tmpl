{{ if .machine.hasGui }}
# GUI Applications - Terminals
cask "iterm2"
cask "ghostty"         # Modern GPU-accelerated terminal
cask "kitty"           # GPU-based terminal emulator
cask "warp"            # AI-powered terminal

# GUI Applications - Editors & IDEs
cask "sublime-text"
cask "sublime-merge"   # Git client from Sublime
cask "zed"             # High-performance multiplayer editor

# GUI Applications - Development
cask "postman"
cask "insomnia"        # REST/GraphQL API client
cask "bruno"           # Local-first API client
cask "tableplus"       # Database GUI
cask "pgadmin4"        # PostgreSQL admin GUI
cask "devpod"          # Codespaces-like dev environments
cask "ngrok"           # Secure tunnels to localhost
cask "clickhouse"      # ClickHouse client

# GUI Applications - Browsers
cask "google-chrome"
cask "firefox"
cask "microsoft-edge"

# GUI Applications - Communication
cask "slack"
cask "discord"
cask "microsoft-teams"
cask "linear"          # Linear issue tracker
cask "rocket-chat"

# GUI Applications - Productivity
cask "notion"
cask "obsidian"
cask "rectangle"       # Window manager
cask "raycast"         # Spotlight alternative
cask "caffeine"        # Keep Mac awake
cask "figma"

# GUI Applications - Media
cask "vlc"
cask "audacity"
cask "gimp"
cask "inkscape"
cask "libreoffice"

# GUI Applications - AI / Local Models
cask "ollama-app"      # Run LLMs locally (renamed from "ollama")

# GUI Applications - Utilities
cask "the-unarchiver"
cask "appcleaner"
cask "keepingyouawake"
cask "stats"           # System monitor in menu bar
cask "cyberduck"       # SFTP/cloud storage client
cask "tunnelblick"     # OpenVPN client
cask "xquartz"         # X11 server for macOS
{{ end }}

# Fonts
cask "font-fira-code-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-hack-nerd-font"
cask "font-monaspice-nerd-font"
cask "font-roboto-mono-nerd-font"
cask "font-zed-mono-nerd-font"

# Mac App Store apps (requires mas)
brew "mas"
# mas "Xcode", id: 497799835
# mas "1Password", id: 1333542190

EOF

echo "Homebrew packages and applications installed successfully!"

# Install nvm (Node Version Manager)
if [ ! -d "$HOME/.nvm" ]; then
    echo "Installing nvm..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    echo "nvm installed successfully!"
else
    echo "nvm already installed, skipping..."
fi

# Install global npm packages
if command -v npm &> /dev/null; then
    echo "Installing global npm packages..."

    npm install -g \
        @anthropic-ai/claude-code \
        @openai/codex \
        @devcontainers/cli \
        @mermaid-js/mermaid-cli \
        @usebruno/cli \
        @northflank/cli \
        aws-cdk \
        concurrently \
        dotenv-cli \
        esbuild \
        graphql-cli \
        jest \
        neonctl \
        nx \
        ts-node \
        tsx \
        typescript \
        webpack-cli

    echo "Global npm packages installed successfully!"
else
    echo "npm not found. Skipping npm package installation."
fi
