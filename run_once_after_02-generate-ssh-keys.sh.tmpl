#!/bin/bash
set -euo pipefail

SSH_DIR="{{ .chezmoi.homeDir }}/.ssh"
mkdir -p "${SSH_DIR}" && chmod 700 "${SSH_DIR}"

{{ if .machine.isDarwin -}}
# macOS: the private key lives in the Secure Enclave via Secretive and never
# touches disk. Secretive creates keys only through its GUI, so this script
# exports the public key once one exists.
PUBKEY_DIR="{{ .chezmoi.homeDir }}/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/PublicKeys"
shopt -s nullglob
pubkeys=("${PUBKEY_DIR}"/*.pub)

if [[ -f "${SSH_DIR}/id_secretive.pub" ]]; then
    echo "Secretive public key already exported, skipping..."
elif (( ${#pubkeys[@]} == 1 )); then
    cp "${pubkeys[0]}" "${SSH_DIR}/id_secretive.pub"
    echo "Exported Secretive public key to ${SSH_DIR}/id_secretive.pub"
    echo "Add this to your GitHub/GitLab account:"
    cat "${SSH_DIR}/id_secretive.pub"
else
    echo "No single Secretive key found (${#pubkeys[@]} in ${PUBKEY_DIR})."
    echo "Open Secretive.app, create a key, then copy its public key to"
    echo "${SSH_DIR}/id_secretive.pub and re-run: chezmoi state delete-bucket --bucket=scriptState && chezmoi apply"
fi
{{- else -}}
if [[ ! -f "${SSH_DIR}/id_ed25519" ]]; then
    echo "Generating SSH key..."
    ssh-keygen -t ed25519 -C "{{ .git.email }}" -f "${SSH_DIR}/id_ed25519" -N ""
    echo "SSH key generated: ${SSH_DIR}/id_ed25519.pub"
    echo "Add this to your GitHub/GitLab account:"
    cat "${SSH_DIR}/id_ed25519.pub"
else
    echo "SSH key already exists, skipping..."
fi
{{- end }}
