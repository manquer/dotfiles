# Load secrets live from the macOS Keychain on each shell start.
# Service "chezmoi"; populated by run_once_before_01-setup-keychain.sh.tmpl.
# Nothing is written to disk in plaintext — values stay in the Keychain.
{{ if .machine.isDarwin -}}
__load_secret() {
  local val
  val="$(security find-generic-password -s chezmoi -a "$1" -w 2>/dev/null)" || return 0
  [[ -n "$val" ]] && export "$1=$val"
}

for __secret in \
{{- if .machine.isWork }}
  GITHUB_TOKEN LINEAR_API_KEY \
  SENTRY_AUTH_TOKEN NORTHFLANK_API_TOKEN GT_AUTH_TOKEN \
  NGROK_AUTHTOKEN FONTAWESOME_NPM_AUTH_TOKEN
{{- else }}
  GITHUB_TOKEN
{{- end }}
do
  __load_secret "$__secret"
done
unset __secret
unfunction __load_secret
{{ end -}}
