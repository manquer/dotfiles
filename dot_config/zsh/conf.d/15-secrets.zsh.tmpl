# Load secrets live from the macOS Keychain on each shell start.
# Service "chezmoi"; populated by run_once_before_01-setup-keychain.sh.tmpl.
# Nothing is written to disk in plaintext — values stay in the Keychain.
{{ if .machine.isDarwin -}}
__load_secret() {
  local val
  val="$(security find-generic-password -s chezmoi -a "$1" -w 2>/dev/null)" || return 0
  # The setup script's `chezmoi secret keyring set` call re-encodes whatever
  # `security add-generic-password` just wrote, storing it in the *same*
  # Keychain item as `go-keyring-base64:<base64 payload>` instead of plain
  # text. Unwrap that here so callers always get the real secret.
  if [[ "$val" == go-keyring-base64:* ]]; then
    val="$(printf '%s' "${val#go-keyring-base64:}" | base64 -D 2>/dev/null)"
  fi
  [[ -n "$val" ]] && export "$1=$val"
}

for __secret in \
{{- if .machine.isWork }}
  GITHUB_TOKEN LINEAR_API_KEY \
  SENTRY_AUTH_TOKEN NORTHFLANK_API_TOKEN GT_AUTH_TOKEN \
  RXDB_PREMIUM NGROK_AUTHTOKEN FONTAWESOME_NPM_AUTH_TOKEN \
  CONTEXT7_API_KEY
{{- else }}
  GITHUB_TOKEN
{{- end }}
do
  __load_secret "$__secret"
done
unset __secret
unfunction __load_secret
{{ end -}}
