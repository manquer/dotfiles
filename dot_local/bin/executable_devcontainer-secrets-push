#!/usr/bin/env bash
# Push the Keychain secrets and the non-secret TURBO_* pair into a devcontainer's
# ~/.secrets.zsh, the per-container file RFC-0062 §2.2 sanctions for a personal
# credential. `containerEnv` is NOT that place: assert-config.sh §2.1 fails an
# unsanctioned *_TOKEN there, and containerEnv resolves once at container CREATE
# time so a rotated value never propagates.
#
# WHY THIS SCRIPT EXISTS AT ALL: /home/node does NOT survive `devpod up
# --recreate` — only the /workspace bind mount does. So ~/.secrets.zsh and the
# ~/.zshenv that sources it are lost on every recreate, silently: a shell starts
# fine, `turbo` just stops using the remote cache. Measured 2026-09-07 —
# crusible-dev-4 and -5 had lost all nine values while -0..-3 still had them.
#
# ~/.zshenv, not ~/.zshrc: a non-interactive `zsh -c`, which is what an agent
# tool call and a `mise` task run, does not source ~/.zshrc (RFC-0062 §2.2).
#
# Values are read live from the macOS Keychain (service "chezmoi") and ~/.env,
# the same two sources ~/.config/zsh/conf.d/{15-secrets,05-env}.zsh read. They
# travel on stdin, never on argv — argv is visible in `ps` on the shared host.
set -euo pipefail

readonly SERVICE=chezmoi

# RXDB_PREMIUM is deliberately absent: devcontainer.json's containerEnv carries
# it, and RFC-0062 §2.2's table sanctions it there.
# `readonly` is deliberately absent on both arrays: /bin/bash is still 3.2 on
# macOS and a readonly array is not portable to it.
SECRETS=(
	NORTHFLANK_API_TOKEN
	CLOUDFLARE_API_TOKEN
	GITHUB_TOKEN
	SENTRY_AUTH_TOKEN
	NGROK_AUTHTOKEN
	FONTAWESOME_NPM_AUTH_TOKEN
	TURBO_TOKEN
)

# Non-secret, and read from ~/.env rather than restated here: that file is the
# chezmoi-managed source, and TURBO_TEAM is per-repository (crusible, not
# webclients) so a second copy would be a second thing to get wrong.
PLAIN=(TURBO_API TURBO_TEAM)

die() {
	printf 'devcontainer-secrets-push: %s\n' "$1" >&2
	exit 1
}

# The Keychain read, matching conf.d/15-secrets.zsh exactly.
#
# `chezmoi secret keyring set` re-encodes whatever `security add-generic-password`
# wrote, storing it as `go-keyring-base64:<payload>` in the SAME item — so unwrap.
# /usr/bin/base64 BY ABSOLUTE PATH, not `base64`: conf.d/00-path.zsh puts
# coreutils' gnubin ahead of /usr/bin and GNU base64 rejects the BSD `-D` spelling.
read_keychain() {
	local name="$1" val decoded
	val="$(security find-generic-password -s "${SERVICE}" -a "${name}" -w 2>/dev/null)" ||
		die "${name} is not in the Keychain (service ${SERVICE})"
	if [[ "${val}" == go-keyring-base64:* ]]; then
		decoded="$(printf '%s' "${val#go-keyring-base64:}" | /usr/bin/base64 -D 2>&1)" ||
			die "cannot decode ${name} from the Keychain: ${decoded}"
		val="${decoded}"
	fi
	# Fatal, never an empty export. An empty value writes a file that looks
	# correct and leaves every consumer failing on a name it can see is set.
	[[ -n "${val}" ]] || die "${name} is empty in the Keychain"
	printf '%s' "${val}"
}

read_dotenv() {
	local name="$1" val
	val="$(sed -n "s/^export ${name}=\"\{0,1\}\([^\"]*\)\"\{0,1\}$/\1/p" "${HOME}/.env" | head -1)"
	[[ -n "${val}" ]] || die "${name} is not set in ~/.env"
	printf '%s' "${val}"
}

# Default targets are the ssh aliases DevPod itself wrote into ~/.ssh/config, so
# this stays provider-agnostic: no docker, no host address, no container name.
default_targets() {
	sed -n 's/^Host \(crusible-dev-[0-9]*\.devpod\)$/\1/p' "${HOME}/.ssh/config" | sort
}

# `$#`, not `${#targets[@]}`: under `set -u` bash 3.2 calls an empty array an
# unbound variable, and /bin/bash is still 3.2 on macOS.
targets=("$@")
if [[ $# -eq 0 ]]; then
	# A read loop, not `mapfile`: mapfile is bash 4+ and /bin/bash is 3.2 here.
	while IFS= read -r host; do
		targets+=("${host}")
	done < <(default_targets)
	[[ ${#targets[@]} -gt 0 ]] || die "no crusible-dev-*.devpod host in ~/.ssh/config and no target given"
fi

payload="$(
	umask 077
	echo '# Written from the Mac (Keychain + ~/.env). Untracked, per-container, 0600.'
	echo '# Source of truth: ~/.config/zsh/conf.d/{05-env,15-secrets}.zsh on the Mac.'
	echo '# Rotating a value there does NOT propagate here. Rewrite this file.'
	echo '# RXDB_PREMIUM is absent on purpose: devcontainer.json containerEnv carries it.'
	echo '# TURBO_TEAM is the crusible value; webclients uses its own per-worktree .env.'
	for name in "${SECRETS[@]}"; do
		printf 'export %s=%s\n' "${name}" "$(read_keychain "${name}")"
	done
	for name in "${PLAIN[@]}"; do
		printf 'export %s=%s\n' "${name}" "$(read_dotenv "${name}")"
	done
)"

status=0
for target in "${targets[@]}"; do
	printf '==> %s\n' "${target}"

	# One ssh invocation writes the file, wires ~/.zshenv and reports back, so a
	# slow DevPod ProxyCommand is paid once per container rather than three times.
	#
	# The ~/.zshenv line is APPENDED only when absent: a contributor may keep a
	# real ~/.zshenv, and clobbering it to add one line is not this script's call.
	#
	# The verification runs `zsh -c`, the NON-interactive form, because that is
	# what an agent tool call and a `mise` task get. `/proc/<pid>/environ` is not
	# a probe for this: Linux shows the exec-time copy and a shell's own `export`
	# never updates it, so a working shell reads as zero there.
	if ! printf '%s\n' "${payload}" | ssh -o BatchMode=yes "${target}" '
		set -eu
		umask 077
		cat > "${HOME}/.secrets.zsh"
		chmod 600 "${HOME}/.secrets.zsh"
		if ! grep -q "\.secrets\.zsh" "${HOME}/.zshenv" 2>/dev/null; then
			printf "%s\n" "[[ -f ~/.secrets.zsh ]] && source ~/.secrets.zsh" >> "${HOME}/.zshenv"
			chmod 644 "${HOME}/.zshenv"
		fi
		printf "    %s exports, TURBO_* visible to a non-interactive zsh: %s\n" \
			"$(grep -c "^export " "${HOME}/.secrets.zsh")" \
			"$(zsh -c "env | grep -c \"^TURBO_\"" 2>/dev/null || echo 0)"
	' 2>/dev/null; then
		printf '    FAILED — not reachable, or the write was refused\n' >&2
		status=1
	fi
done

# The turbo remote cache gets a SECOND path, by file, and this is not redundancy.
# ~/.secrets.zsh reaches a shell started after it was written; nothing reaches a
# process that already froze its environment. `.turbo/config.json` is re-read on
# every turbo invocation, so a long-lived agent still gets the cache. The seed
# script itself lives under /home/node, which a recreate destroys, so it is
# reinstalled here rather than assumed present.
seed_local="${HOME}/.local/bin/turbo-remote-cache-seed"
if [[ -x "${seed_local}" ]]; then
	for target in "${targets[@]}"; do
		printf '==> %s (turbo cache config)\n' "${target}"
		if ! ssh -o BatchMode=yes "${target}" '
			set -eu
			mkdir -p "${HOME}/.local/bin"
			cat > "${HOME}/.local/bin/turbo-remote-cache-seed"
			chmod 755 "${HOME}/.local/bin/turbo-remote-cache-seed"
			cd /workspace
			printf "    %s\n" "$("${HOME}/.local/bin/turbo-remote-cache-seed")"
		' < "${seed_local}" 2>/dev/null; then
			printf '    FAILED — turbo cache config not written\n' >&2
			status=1
		fi
	done
else
	# SC2016: the backticks are prose in help text, not a command substitution.
	# shellcheck disable=SC2016
	printf '\n%s is not installed — run `chezmoi apply` first.\n' "${seed_local}" >&2
	printf 'Without it no worktree in these containers gets .turbo/config.json.\n' >&2
	status=1
fi

# A pane or agent that was ALREADY running keeps its own frozen environment;
# nothing written to ~/.secrets.zsh reaches a live process. `.turbo/config.json`
# above covers turbo for those processes; every other variable still needs either
# `source ~/.secrets.zsh` in an idle shell pane or a restart of the agent.
printf '\nAlready-running panes and agents keep the old environment.\n'
printf 'Turbo is covered by .turbo/config.json; everything else needs\n'
# shellcheck disable=SC2016
printf '`source ~/.secrets.zsh` in an idle shell pane, or an agent restart.\n'
exit "${status}"
