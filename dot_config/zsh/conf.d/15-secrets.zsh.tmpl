# Load secrets live from the macOS Keychain on each shell start.
# Service "chezmoi"; populated by run_once_before_01-setup-keychain.sh.tmpl.
# Nothing is written to disk in plaintext — values stay in the Keychain.
{{ if .machine.isDarwin -}}
__load_secret() {
  local val decoded
  val="$(security find-generic-password -s chezmoi -a "$1" -w 2>/dev/null)" || return 0
  # The setup script's `chezmoi secret keyring set` call re-encodes whatever
  # `security add-generic-password` just wrote, storing it in the *same*
  # Keychain item as `go-keyring-base64:<base64 payload>` instead of plain
  # text. Unwrap that here so callers always get the real secret.
  #
  # /usr/bin/base64 by absolute path, NOT `base64`: conf.d/00-path.zsh puts
  # coreutils' gnubin ahead of /usr/bin, and GNU base64 rejects the BSD `-D`
  # spelling this decode needs. A bare `base64 -D` resolves to GNU here and
  # fails on every shell start.
  if [[ "$val" == go-keyring-base64:* ]]; then
    if ! decoded="$(printf '%s' "${val#go-keyring-base64:}" | /usr/bin/base64 -D 2>&1)"; then
      # Never swallow this. A silent decode failure leaves the variable unset,
      # and every long-lived process started from that shell — tmux, herdr's
      # server, a devcontainer built from ${localEnv:...} — freezes the gap.
      print -u2 "15-secrets: cannot decode $1 from the Keychain: $decoded"
      return 0
    fi
    val="$decoded"
  fi
  [[ -n "$val" ]] && export "$1=$val"
}

for __secret in \
{{- if .machine.isWork }}
  GITHUB_TOKEN SENTRY_AUTH_TOKEN \
  NORTHFLANK_API_TOKEN CLOUDFLARE_API_TOKEN TURBO_TOKEN \
  RXDB_PREMIUM NGROK_AUTHTOKEN FONTAWESOME_NPM_AUTH_TOKEN
{{- else }}
  GITHUB_TOKEN
{{- end }}
do
  __load_secret "$__secret"
done
unset __secret
unfunction __load_secret
{{ end -}}
