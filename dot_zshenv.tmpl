# ~/.zshenv - loaded first, for ALL zsh invocations (scripts, interactive, login)

# XDG Base Directory Specification
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_STATE_HOME="${HOME}/.local/state"

# Local binaries on PATH for non-interactive shells too (conf.d re-asserts this
# for interactive shells, but scripts only see what is set here).
export PATH="${HOME}/.local/bin:${PATH}"

# Editor
export EDITOR="nvim"
export VISUAL="nvim"

# Language
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# History settings live in ~/.config/zsh/conf.d/05-env.zsh so they take effect
# AFTER Oh My Zsh loads (it would otherwise override HISTFILE).

{{ if .machine.isDarwin }}
# macOS specific
export DOCKER_HOST="unix://${HOME}/.config/colima/default/docker.sock"
{{ end }}

# NODE_ENV IS DELIBERATELY NOT EXPORTED HERE. A login-shell NODE_ENV reaches
# every tool that reads it, and two of them change behaviour destructively:
# `pnpm install` omits devDependencies under `production`, and Vite resolves the
# `development|production` export condition from it — so a dev server resolves a
# workspace package's `production` entry and fails on packages that build no
# `dist/`. Per-project `.env`/`.envrc` files own this variable instead.
