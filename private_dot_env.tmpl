# Non-secret environment variables — managed by chezmoi.
# Sourced by ~/.config/zsh/conf.d/05-env.zsh on shell start.
#
# SECRETS ARE NOT STORED HERE. They are read live from the macOS Keychain
# (service "chezmoi") on each shell start by conf.d/15-secrets.zsh.
# First-time setup / adding secrets: see run_once_before_01-setup-keychain.sh.tmpl
# or: security add-generic-password -s chezmoi -a NAME -w 'value' -T /usr/bin/security -U

# NODE_ENV IS DELIBERATELY NOT SET HERE — see the note at the end of
# ~/.zshenv. This file is sourced by conf.d/05-env.zsh on every shell start,
# so anything exported here lands in the login shell just as ~/.zshenv would.
# Per-project `.env`/`.envrc` files own NODE_ENV instead.
{{ if .machine.isWork -}}
export AWS_PROFILE="work-profile"
export AWS_REGION="us-east-1"
{{ end }}
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export LESS="-R"
export CLICOLOR=1

{{ if .machine.isDarwin -}}
export DOCKER_HOST="unix://${HOME}/.config/colima/default/docker.sock"
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1
{{ end -}}
